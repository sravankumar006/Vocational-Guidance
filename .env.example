# =================================================================
# Root Environment Configuration Template (.env.example)
# Safe for version control. Do NOT commit real secrets here.
# =================================================================

# AI Provider Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Custom / Self-Hosted Model Configuration
OWN_MODEL_URL=

# Database Connection (PostgreSQL with pgvector support)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sih_db

# Application Configuration
PROJECT_NAME="Vocational Guidance Platform API"
APP_ENV=development
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Authentication & Security Configuration (Phase 1 Brick 7)
AUTH_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173
